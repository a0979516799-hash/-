# 伺服器設定
PORT=3000
NODE_ENV=development

# JWT 身份驗證安全密鑰 (生產環境請使用高強度隨機字串)
JWT_SECRET=replace_this_with_a_long_random_secret_key_in_production

# 資料庫選擇 (sqlite 或 mysql)
DB_TYPE=sqlite

# SQLite 設定 (開箱即用，免安裝伺服器)
SQLITE_PATH=./data/database.sqlite

# MySQL 設定 (若日後切換為 MySQL 伺服器，請將 DB_TYPE 改為 mysql 並填入以下資訊)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=grad_project_db

# 前端允許的網域 (CORS 白名單)
ALLOWED_ORIGIN=http://localhost:3000
